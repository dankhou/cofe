Option Explicit

'==============================================================================
'  770 INVENTORY TOOLS
'
'  Buttons (created by Inv_Setup, top-right of the sheet):
'    + ADD ITEM   - jumps to the next blank row, ready for a barcode scan,
'                   then walks you through Description > Shelf > Bin
'    FIND         - scan/type a part # (partial text OK, also searches descriptions)
'    PULL / USE   - scan a part, take qty out of stock (logged)
'    RECEIVE      - scan a part, add qty to stock, reduces On Order (logged)
'    MERGE DUPES  - combines rows that share the same part number (backup first)
'    SORT         - by location (Shelf > Bin > Part #) or by Part #
'    LOW STOCK    - report of items that are out or at/below MIN STOCK
'    SHOW ALL     - un-hides rows after a FIND
'
'  ONE-TIME SETUP: paste the sheet code into the "770 Inventory" sheet
'  module, then run Inv_Setup (Alt+F8). If anything acts stuck, run Inv_Reset.
'==============================================================================

'------------------------------- SETTINGS -------------------------------------
Private Const SHEET_NAME As String = "770 Inventory"
Private Const HEADER_ROW As Long = 5          ' first row of the column titles (titles may span rows 5-6)
Private Const FIRST_DATA_ROW As Long = 7      ' first row that holds parts
Private Const MAX_ROW As Long = 5000          ' dropdowns / highlighting cover rows down to here
Private Const LISTS_SHEET As String = "Lists"
Private Const LOG_SHEET As String = "Inventory Log"
Private Const REPORT_SHEET As String = "Low Stock"
Private Const APP_TITLE As String = "770 Inventory"
Private Const MAIN_FONT_SIZE As Double = 10   ' description main line
Private Const SUB_FONT_SIZE As Double = 8     ' description sub line
Private Const BTN_PREFIX As String = "btnInv_"
Private Const BTN_ANCHOR_COL As String = "M"  ' buttons start at this column, rows 1-2
Private Const CUSTOM_ITEM As String = "CUSTOM (TYPE YOUR OWN ENTRY)"
Private Const HOLD_TEXT As String = "HOLD - DO NOT USE"

'------------------------------- STATE ----------------------------------------
Private cScan As Long, cPart As Long, cDesc As Long, cShelf As Long, cBin As Long
Private cOnHand As Long, cMin As Long, cCond As Long, cOnOrder As Long, cOrderNo As Long
Private cProgram As Long, cCharge As Long, cLastPurch As Long, cTNum As Long
Private cBarPrint As Long, cSku As Long, cMfg As Long, cLastCol As Long

Private gPendingRow As Long
Private gPrevDescAddr As String
Private gPrevDescVal As String
Private gBusy As Boolean
Private gAutoCompleteWas As Boolean
Private gACStored As Boolean


'==============================================================================
'                                BUTTON MACROS
'==============================================================================

Public Sub Inv_AddItem()
    Dim ws As Worksheet
    Set ws = GetInv(): If ws Is Nothing Then Exit Sub
    On Error GoTo Fail
    Application.EnableEvents = False
    StartNewItem ws
Done:
    Application.EnableEvents = True
    Exit Sub
Fail:
    ShowErr
    Resume Done
End Sub

Public Sub Inv_Find()
    Dim ws As Worksheet, txt As String, k As String, cancelled As Boolean
    Dim r As Long, lastR As Long, i As Long, nHit As Long
    Dim vP As Variant, vD As Variant, hits() As Long

    Set ws = GetInv(): If ws Is Nothing Then Exit Sub
    txt = AskText("Scan or type a PART NUMBER." & vbLf & vbLf & _
                  "Partial text works too (e.g. TV06 or CONNECTOR) - it searches " & _
                  "part numbers and descriptions.", "Find Item", "", cancelled)
    If cancelled Or txt = "" Then Exit Sub

    On Error GoTo Fail
    Application.EnableEvents = False
    Application.ScreenUpdating = False
    ShowAllRows ws

    r = FindPartRow(ws, txt, 0)
    If r > 0 Then
        Application.ScreenUpdating = True
        SelectRow ws, r, cPart
        GoTo Done
    End If

    k = NormKey(txt)
    lastR = LastDataRow(ws)
    If lastR >= FIRST_DATA_ROW Then
        vP = ColValues(ws, cPart, lastR)
        vD = ColValues(ws, cDesc, lastR)
        ReDim hits(1 To UBound(vP, 1))
        For i = 1 To UBound(vP, 1)
            If InStr(1, NormKey(vP(i, 1)), k, vbBinaryCompare) > 0 Or _
               InStr(1, UCase$(CellText(vD(i, 1))), k, vbBinaryCompare) > 0 Then
                nHit = nHit + 1
                hits(nHit) = i + FIRST_DATA_ROW - 1
            End If
        Next i
    End If

    If nHit = 0 Then
        Application.ScreenUpdating = True
        MsgBox "Nothing found matching """ & txt & """.", vbInformation, APP_TITLE
    ElseIf nHit = 1 Then
        Application.ScreenUpdating = True
        SelectRow ws, hits(1), cPart
    Else
        ws.Rows(FIRST_DATA_ROW & ":" & lastR).Hidden = True
        For i = 1 To nHit
            ws.Rows(hits(i)).Hidden = False
        Next i
        Application.ScreenUpdating = True
        SelectRow ws, hits(1), cPart
        MsgBox nHit & " matches for """ & txt & """ are shown." & vbLf & _
               "Click SHOW ALL to see the full list again.", vbInformation, APP_TITLE
    End If
Done:
    Application.ScreenUpdating = True
    Application.EnableEvents = True
    Exit Sub
Fail:
    ShowErr
    Resume Done
End Sub

Public Sub Inv_ShowAll()
    Dim ws As Worksheet
    Set ws = GetInv(): If ws Is Nothing Then Exit Sub
    ShowAllRows ws
    Application.StatusBar = False
End Sub

Public Sub Inv_Pull()
    Dim ws As Worksheet, txt As String, cancelled As Boolean, r As Long
    Set ws = GetInv(): If ws Is Nothing Then Exit Sub
    On Error GoTo Fail
    Application.EnableEvents = False
    ShowAllRows ws
    Do
        txt = AskText("Scan or type the PART NUMBER to PULL from stock." & vbLf & vbLf & _
                      "(Click Cancel when you're finished.)", "Pull / Use Item", "", cancelled)
        If cancelled Then Exit Do
        If txt <> "" Then
            r = FindPartRow(ws, txt, 0)
            If r = 0 Then
                MsgBox "Part """ & txt & """ is not in the inventory.", vbExclamation, APP_TITLE
            Else
                DoPull ws, r
            End If
        End If
    Loop
Done:
    Application.EnableEvents = True
    Exit Sub
Fail:
    ShowErr
    Resume Done
End Sub

Public Sub Inv_Receive()
    Dim ws As Worksheet, txt As String, cancelled As Boolean, r As Long
    Set ws = GetInv(): If ws Is Nothing Then Exit Sub
    On Error GoTo Fail
    Application.EnableEvents = False
    ShowAllRows ws
    Do
        txt = AskText("Scan or type the PART NUMBER being RECEIVED." & vbLf & vbLf & _
                      "(Click Cancel when you're finished.)", "Receive Item", "", cancelled)
        If cancelled Then Exit Do
        If txt <> "" Then
            r = FindPartRow(ws, txt, 0)
            If r = 0 Then
                If MsgBox("Part """ & txt & """ is not in the inventory yet." & vbLf & vbLf & _
                          "Add it as a NEW item?", vbYesNo + vbQuestion, APP_TITLE) = vbYes Then
                    StartNewItem ws
                    If gPendingRow > 0 Then
                        ws.Cells(gPendingRow, cPart).Value = txt
                        OnPartEntered ws, ws.Cells(gPendingRow, cPart)
                    End If
                    Exit Do
                End If
            Else
                DoReceive ws, r
            End If
        End If
    Loop
Done:
    Application.EnableEvents = True
    Exit Sub
Fail:
    ShowErr
    Resume Done
End Sub

Public Sub Inv_MergeDuplicates()
    Dim ws As Worksheet, lastR As Long, data As Variant, n As Long, i As Long, j As Long
    Dim firstIdx As Object, grp As Object, k As String, dupCount As Long
    Dim delRng As Range, bk As String, conflicts As String, addOH As Double, logNote As String

    Set ws = GetInv(): If ws Is Nothing Then Exit Sub
    On Error GoTo Fail
    Application.EnableEvents = False
    ShowAllRows ws

    lastR = LastDataRow(ws)
    If lastR <= FIRST_DATA_ROW Then
        MsgBox "No duplicate part numbers found.", vbInformation, APP_TITLE
        GoTo Done
    End If

    data = ws.Range(ws.Cells(FIRST_DATA_ROW, 1), ws.Cells(lastR, cLastCol)).Value
    n = UBound(data, 1)
    Set firstIdx = CreateObject("Scripting.Dictionary")
    Set grp = CreateObject("Scripting.Dictionary")
    For i = 1 To n
        k = NormKey(data(i, cPart))
        If k <> "" Then
            If firstIdx.Exists(k) Then
                dupCount = dupCount + 1
                grp(k) = True
            Else
                firstIdx.Add k, i
            End If
        End If
    Next i

    If dupCount = 0 Then
        MsgBox "No duplicate part numbers found - nothing to merge.", vbInformation, APP_TITLE
        GoTo Done
    End If

    If MsgBox("Found " & dupCount & " duplicate row(s) covering " & grp.Count & " part number(s)." & vbLf & vbLf & _
              "Each part will be combined into its FIRST row:" & vbLf & _
              "  - ON HAND and ON ORDER quantities are added together" & vbLf & _
              "  - Blank fields are filled in from the duplicate rows" & vbLf & _
              "  - Different shelves/bins/programs are kept, joined with "" / """ & vbLf & _
              "  - The extra rows are deleted" & vbLf & vbLf & _
              "A backup copy of the sheet is made first. Continue?", _
              vbYesNo + vbQuestion, "Merge Duplicates") = vbNo Then GoTo Done

    Application.ScreenUpdating = False
    bk = MakeBackup(ws)

    For i = 1 To n
        k = NormKey(data(i, cPart))
        If k <> "" Then
            j = firstIdx(k)
            If j <> i Then
                conflicts = ""
                addOH = NumVal(data(i, cOnHand))
                MergeRowInto ws, data, j, i, conflicts
                logNote = "Row " & (i + FIRST_DATA_ROW - 1) & " merged into row " & (j + FIRST_DATA_ROW - 1) & _
                          " (row numbers before merge)"
                If conflicts <> "" Then logNote = logNote & " | CHECK: " & conflicts
                WriteLog "MERGE", CellText(data(j, cPart)), addOH, NumVal(data(j, cOnHand)), logNote
                If delRng Is Nothing Then
                    Set delRng = ws.Rows(i + FIRST_DATA_ROW - 1)
                Else
                    Set delRng = Union(delRng, ws.Rows(i + FIRST_DATA_ROW - 1))
                End If
            End If
        End If
    Next i

    If Not delRng Is Nothing Then delRng.Delete Shift:=xlUp
    gPendingRow = 0
    Application.ScreenUpdating = True
    ws.Activate
    MsgBox "Done. Combined " & dupCount & " duplicate row(s) into " & grp.Count & " part(s)." & vbLf & vbLf & _
           "Backup sheet: " & bk & vbLf & _
           "Details (including parts stored in more than one location) are on the '" & _
           LOG_SHEET & "' sheet.", vbInformation, APP_TITLE
Done:
    Application.ScreenUpdating = True
    Application.EnableEvents = True
    Exit Sub
Fail:
    ShowErr
    Resume Done
End Sub

Public Sub Inv_Sort()
    Dim ws As Worksheet, ans As VbMsgBoxResult, lastR As Long, rng As Range
    Set ws = GetInv(): If ws Is Nothing Then Exit Sub
    ans = MsgBox("How do you want to sort?" & vbLf & vbLf & _
                 "YES  =  by Location (Shelf, then Bin, then Part #)" & vbLf & _
                 "NO   =  by Part Number" & vbLf & _
                 "CANCEL = don't sort", vbYesNoCancel + vbQuestion, APP_TITLE)
    If ans = vbCancel Then Exit Sub

    On Error GoTo Fail
    Application.EnableEvents = False
    Application.ScreenUpdating = False
    ShowAllRows ws
    lastR = LastDataRow(ws)
    If lastR <= FIRST_DATA_ROW Then GoTo Done

    Set rng = ws.Range(ws.Cells(FIRST_DATA_ROW, 1), ws.Cells(lastR, cLastCol))
    With ws.Sort
        .SortFields.Clear
        If ans = vbYes Then
            .SortFields.Add Key:=rng.Columns(cShelf), Order:=xlAscending, DataOption:=xlSortNormal
            If cBin > 0 Then .SortFields.Add Key:=rng.Columns(cBin), Order:=xlAscending, DataOption:=xlSortTextAsNumbers
        End If
        .SortFields.Add Key:=rng.Columns(cPart), Order:=xlAscending, DataOption:=xlSortNormal
        .SetRange rng
        .Header = xlNo
        .MatchCase = False
        .Orientation = xlTopToBottom
        .Apply
    End With
    gPendingRow = 0
Done:
    Application.ScreenUpdating = True
    Application.EnableEvents = True
    Exit Sub
Fail:
    ShowErr
    Resume Done
End Sub

Public Sub Inv_LowStockReport()
    Dim ws As Worksheet, rp As Worksheet, lastR As Long, i As Long, pass As Long, outR As Long
    Dim vP As Variant, vD As Variant, vS As Variant, vB As Variant, vOH As Variant
    Dim vMin As Variant, vOO As Variant, vPr As Variant, vC As Variant
    Dim oh As Double, mn As Double, oo As Double, status As String, want As String
    Dim cnt(1 To 3) As Long

    Set ws = GetInv(): If ws Is Nothing Then Exit Sub
    On Error GoTo Fail
    Application.ScreenUpdating = False
    Application.EnableEvents = False

    lastR = LastDataRow(ws)
    If lastR < FIRST_DATA_ROW Then
        MsgBox "There are no items yet.", vbInformation, APP_TITLE
        GoTo Done
    End If
    vP = ColValues(ws, cPart, lastR)
    vD = ColValues(ws, cDesc, lastR)
    vS = ColValues(ws, cShelf, lastR)
    vOH = ColValues(ws, cOnHand, lastR)
    vB = ColValuesOpt(ws, cBin, lastR)
    vMin = ColValuesOpt(ws, cMin, lastR)
    vOO = ColValuesOpt(ws, cOnOrder, lastR)
    vPr = ColValuesOpt(ws, cProgram, lastR)
    vC = ColValuesOpt(ws, cCond, lastR)

    Set rp = GetOrCreateSheet(REPORT_SHEET)
    If rp.AutoFilterMode Then rp.AutoFilterMode = False
    rp.Cells.Clear
    rp.Range("A1").Value = "LOW STOCK REPORT  -  " & Format$(Now, "mm/dd/yyyy h:mm AM/PM")
    rp.Range("A1").Font.Bold = True
    rp.Range("A1").Font.Size = 14
    rp.Range("A3:K3").Value = Array("STATUS", "PART NUMBER", "DESCRIPTION", "SHELF", "BIN", "ON HAND", _
                                    "MIN STOCK", "ON ORDER", "SUGGESTED ORDER", "PROGRAM USED", "GO TO")
    With rp.Range("A3:K3")
        .Font.Bold = True
        .Font.Color = RGB(255, 255, 255)
        .Interior.Color = RGB(31, 56, 100)
        .WrapText = True
        .VerticalAlignment = xlCenter
    End With

    outR = 3
    For pass = 1 To 3
        want = Choose(pass, "OUT", "LOW", "HOLD")
        For i = 1 To UBound(vP, 1)
            If NormKey(vP(i, 1)) <> "" Then
                oh = NumVal(vOH(i, 1))
                mn = NumVal(ArrVal(vMin, i))
                oo = NumVal(ArrVal(vOO, i))
                status = ""
                If InStr(1, UCase$(CellText(ArrVal(vC, i))), "HOLD") > 0 Then
                    If oh <= 0 Or (mn > 0 And oh <= mn) Then status = "HOLD"
                ElseIf oh <= 0 Then
                    status = "OUT"
                ElseIf mn > 0 And oh <= mn Then
                    status = "LOW"
                End If
                If status = want Then
                    outR = outR + 1
                    cnt(pass) = cnt(pass) + 1
                    rp.Cells(outR, 1).Value = status
                    rp.Cells(outR, 2).NumberFormat = "@"
                    rp.Cells(outR, 2).Value = CellText(vP(i, 1))
                    rp.Cells(outR, 3).Value = Replace(CellText(vD(i, 1)), vbLf, " - ")
                    rp.Cells(outR, 4).Value = CellText(vS(i, 1))
                    rp.Cells(outR, 5).Value = ArrVal(vB, i)
                    rp.Cells(outR, 6).Value = oh
                    rp.Cells(outR, 7).Value = mn
                    rp.Cells(outR, 8).Value = oo
                    If mn > 0 And (mn - oh - oo) > 0 Then rp.Cells(outR, 9).Value = mn - oh - oo
                    rp.Cells(outR, 10).Value = CellText(ArrVal(vPr, i))
                    rp.Cells(outR, 11).Formula = "=HYPERLINK(""#'" & SHEET_NAME & "'!" & ColL(cPart) & _
                        (i + FIRST_DATA_ROW - 1) & """,""Row " & (i + FIRST_DATA_ROW - 1) & """)"
                    With rp.Cells(outR, 1)
                        .Font.Bold = True
                        .Font.Color = RGB(255, 255, 255)
                        Select Case status
                            Case "OUT": .Interior.Color = RGB(255, 0, 0)
                            Case "LOW": .Interior.Color = RGB(255, 192, 0): .Font.Color = RGB(0, 0, 0)
                            Case "HOLD": .Interior.Color = RGB(197, 90, 17)
                        End Select
                    End With
                End If
            End If
        Next i
    Next pass

    rp.Range("A2").Value = "OUT of stock: " & cnt(1) & "     LOW (at/below MIN): " & cnt(2) & _
                           "     On HOLD and low: " & cnt(3) & _
                           "     Suggested order = MIN - on hand - on order"
    rp.Range("A2").Font.Italic = True
    rp.Columns("A").ColumnWidth = 8
    rp.Columns("B").ColumnWidth = 22
    rp.Columns("C").ColumnWidth = 45
    rp.Columns("D").ColumnWidth = 18
    rp.Columns("E:I").ColumnWidth = 10
    rp.Columns("J").ColumnWidth = 22
    rp.Columns("K").ColumnWidth = 10
    rp.Range("A3:K" & outR).Borders.LineStyle = xlContinuous
    If rp.AutoFilterMode Then rp.AutoFilterMode = False
    If outR > 3 Then rp.Range("A3:K" & outR).AutoFilter
    rp.Tab.Color = RGB(237, 125, 49)

    Application.ScreenUpdating = True
    rp.Activate
    ActiveWindow.FreezePanes = False
    ActiveWindow.ScrollRow = 1
    ActiveWindow.SplitColumn = 0
    ActiveWindow.SplitRow = 3
    ActiveWindow.FreezePanes = True
    If outR = 3 Then MsgBox "Nothing is out of stock or at/below MIN STOCK.", vbInformation, APP_TITLE
Done:
    Application.ScreenUpdating = True
    Application.EnableEvents = True
    Exit Sub
Fail:
    ShowErr
    Resume Done
End Sub

'--- Run once after pasting (Alt+F8 > Inv_Setup). Safe to run again. ---
Public Sub Inv_Setup()
    Dim ws As Worksheet, prevAddr As String
    Set ws = GetInv(): If ws Is Nothing Then Exit Sub
    On Error GoTo Fail
    Application.ScreenUpdating = False
    Application.EnableEvents = False
    ws.Activate
    On Error Resume Next
    prevAddr = ActiveCell.Address
    On Error GoTo Fail

    BuildLists
    ApplyDropdowns ws
    ApplyHighlighting ws
    GetLogSheet
    BuildButtons ws

    ws.Activate
    If prevAddr <> "" Then ws.Range(prevAddr).Select
    Application.ScreenUpdating = True

    MigrateHoldFills ws

    If MsgBox("Remove the old hand-colored fills from the ON HAND column?" & vbLf & vbLf & _
              "(Red / amber is now applied automatically when stock is out or at/below MIN, " & _
              "so the old manual colors aren't needed. Choose No to keep them.)", _
              vbYesNo + vbQuestion, APP_TITLE) = vbYes Then
        ws.Range(ws.Cells(FIRST_DATA_ROW, cOnHand), _
                 ws.Cells(MaxL(FIRST_DATA_ROW, LastDataRow(ws)), cOnHand)).Interior.Pattern = xlNone
    End If

    MsgBox "Inventory tools are set up!" & vbLf & vbLf & _
           "- Buttons are at the top right of the sheet." & vbLf & _
           "- Dropdown options live on the '" & LISTS_SHEET & "' sheet - edit them there." & vbLf & _
           "- Adds / pulls / receives / merges are recorded on the '" & LOG_SHEET & "' sheet." & vbLf & vbLf & _
           "Save the workbook as .xlsm to keep the macros.", vbInformation, APP_TITLE
Done:
    Application.ScreenUpdating = True
    Application.EnableEvents = True
    Exit Sub
Fail:
    ShowErr
    Resume Done
End Sub

'--- If anything ever seems stuck (dropdown flow not reacting), run this. ---
Public Sub Inv_Reset()
    Application.EnableEvents = True
    Application.ScreenUpdating = True
    Application.StatusBar = False
    RestoreAutoComplete
    gBusy = False
    gPendingRow = 0
End Sub


