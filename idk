Private Sub FillCol(ls As Worksheet, ByVal col As Long, ByVal items As Variant)
    Dim i As Long
    For i = 0 To UBound(items)
        ls.Cells(i + 2, col).Value = items(i)
    Next i
End Sub

Private Sub SetListName(ByVal nm As String, ByVal col As Long)
    Dim L As String
    L = ColL(col)
    On Error Resume Next
    ThisWorkbook.Names(nm).Delete
    On Error GoTo 0
    ThisWorkbook.Names.Add Name:=nm, RefersTo:="=OFFSET('" & LISTS_SHEET & "'!$" & L & "$2,0,0,MAX(1,COUNTA('" & _
        LISTS_SHEET & "'!$" & L & ":$" & L & ")-1),1)"
End Sub

Private Sub AddToList(ByVal col As Long, ByVal item As String)
    Dim ls As Worksheet, lastR As Long
    Set ls = SheetByName(LISTS_SHEET)
    If ls Is Nothing Then Exit Sub
    If Not IsError(Application.Match(item, ls.Columns(col), 0)) Then Exit Sub
    lastR = ls.Cells(ls.Rows.Count, col).End(xlUp).Row
    If UCase$(CellText(ls.Cells(lastR, col).Value)) = CUSTOM_ITEM Then
        ls.Cells(lastR, col).Insert Shift:=xlDown
        ls.Cells(lastR, col).Value = item
    Else
        ls.Cells(lastR + 1, col).Value = item
    End If
End Sub

Private Sub ApplyDropdowns(ws As Worksheet)
    With ColRange(ws, cDesc).Validation
        .Delete
        .Add Type:=xlValidateList, AlertStyle:=xlValidAlertInformation, Operator:=xlBetween, _
             Formula1:="=INV_DescList"
        .IgnoreBlank = True
        .InCellDropdown = True
        .ShowInput = False
        .ShowError = False
    End With
    With ColRange(ws, cShelf).Validation
        .Delete
        .Add Type:=xlValidateList, AlertStyle:=xlValidAlertWarning, Operator:=xlBetween, _
             Formula1:="=INV_ShelfList"
        .IgnoreBlank = True
        .InCellDropdown = True
        .ShowInput = False
        .ShowError = True
        .ErrorTitle = "Shelf location"
        .ErrorMessage = "That isn't one of the standard locations." & vbLf & _
                        "Yes = use it anyway     No = pick from the list" & vbLf & _
                        "(Add new locations on the Lists sheet.)"
    End With
    If cCond > 0 Then
        With ColRange(ws, cCond).Validation
            .Delete
            .Add Type:=xlValidateList, AlertStyle:=xlValidAlertInformation, Operator:=xlBetween, _
                 Formula1:="=INV_CondList"
            .IgnoreBlank = True
            .InCellDropdown = True
            .ShowInput = False
            .ShowError = False
        End With
    End If
End Sub

Private Sub ApplyHighlighting(ws As Worksheet)
    Dim fr As String, P As String, F As String, G As String, H As String, D As String
    Dim rOH As Range, rPart As Range, rShelf As Range, ls As Worksheet
    Dim palette As Variant, i As Long, lastL As Long, item As String

    fr = CStr(FIRST_DATA_ROW)
    P = "$" & ColL(cPart)
    F = "$" & ColL(cOnHand)
    D = "$" & ColL(cShelf)
    Set rOH = ColRange(ws, cOnHand)
    Set rPart = ColRange(ws, cPart)
    Set rShelf = ColRange(ws, cShelf)

    rOH.FormatConditions.Delete
    rPart.FormatConditions.Delete
    rShelf.FormatConditions.Delete
    If cCond > 0 Then ColRange(ws, cCond).FormatConditions.Delete

    ws.Cells(FIRST_DATA_ROW, 1).Select

    If cCond > 0 Then
        H = "$" & ColL(cCond)
        AddRule Union(rPart, ColRange(ws, cCond)), "=ISNUMBER(SEARCH(""HOLD""," & H & fr & "))", _
                RGB(197, 90, 17), RGB(255, 255, 255), True
    End If
    AddRule rOH, "=AND(" & P & fr & "<>"""",IFERROR(--" & F & fr & ",0)<=0)", _
            RGB(255, 0, 0), RGB(255, 255, 255), True
    If cMin > 0 Then
        G = "$" & ColL(cMin)
        AddRule rOH, "=AND(" & P & fr & "<>"""",IFERROR(--" & G & fr & ",0)>0,IFERROR(--" & F & fr & _
                ",0)<=IFERROR(--" & G & fr & ",0))", RGB(255, 192, 0), RGB(0, 0, 0), True
    End If
    AddRule rPart, "=AND(" & P & fr & "<>"""",COUNTIF(" & P & "$" & fr & ":" & P & "$" & MAX_ROW & "," & _
            P & fr & ")>1)", RGB(255, 199, 206), RGB(156, 0, 6), False

    palette = Array(RGB(198, 239, 206), RGB(255, 255, 0), RGB(248, 203, 173), RGB(189, 215, 238), _
                    RGB(225, 204, 240), RGB(217, 217, 217), RGB(204, 236, 255), RGB(237, 226, 200))
    Set ls = SheetByName(LISTS_SHEET)
    If Not ls Is Nothing Then
        lastL = ls.Cells(ls.Rows.Count, 2).End(xlUp).Row
        For i = 2 To lastL
            item = Trim$(CellText(ls.Cells(i, 2).Value))
            If item <> "" And (i - 2) <= UBound(palette) Then
                AddRule rShelf, "=TRIM(" & D & fr & ")=""" & Replace(item, """", """""") & """", _
                        CLng(palette(i - 2)), -1, True
            End If
        Next i
    End If
End Sub

Private Sub AddRule(rng As Range, ByVal f As String, ByVal fillColor As Long, ByVal fontColor As Long, _
                    ByVal stopIfTrue As Boolean)
    Dim fc As Object
    Set fc = rng.FormatConditions.Add(Type:=xlExpression, Formula1:=f)
    fc.SetLastPriority
    fc.Interior.Color = fillColor
    If fontColor >= 0 Then fc.Font.Color = fontColor
    fc.StopIfTrue = stopIfTrue
End Sub

Private Sub BuildButtons(ws As Worksheet)
    Dim i As Long, shp As Shape, specs As Variant
    Dim x0 As Double, y0 As Double, totalW As Double, bw As Double, bh As Double
    Const GAP As Double = 4

    For i = ws.Shapes.Count To 1 Step -1
        If ws.Shapes(i).Name Like BTN_PREFIX & "*" Then ws.Shapes(i).Delete
    Next i

    specs = Array( _
        Array("Inv_AddItem", "+ ADD ITEM", RGB(0, 150, 70)), _
        Array("Inv_Find", "FIND", RGB(47, 84, 150)), _
        Array("Inv_Pull", "PULL / USE", RGB(192, 0, 0)), _
        Array("Inv_Receive", "RECEIVE", RGB(0, 112, 192)), _
        Array("Inv_MergeDuplicates", "MERGE DUPES", RGB(112, 48, 160)), _
        Array("Inv_Sort", "SORT", RGB(89, 89, 89)), _
        Array("Inv_LowStockReport", "LOW STOCK", RGB(237, 125, 49)), _
        Array("Inv_ShowAll", "SHOW ALL", RGB(89, 89, 89)))

    x0 = ws.Range(BTN_ANCHOR_COL & "1").Left + GAP
    y0 = ws.Rows(1).Top + 2
    totalW = ws.Range(BTN_ANCHOR_COL & "1").Resize(1, 5).Width
    bw = (totalW - 5 * GAP) / 4
    If bw < 70 Then bw = 70
    bh = (ws.Rows(1).Height + ws.Rows(2).Height - 3 * GAP) / 2
    If bh > 30 Then bh = 30
    If bh < 18 Then bh = 18

    For i = 0 To UBound(specs)
        Set shp = ws.Shapes.AddShape(msoShapeRoundedRectangle, _
                    x0 + (i Mod 4) * (bw + GAP), y0 + (i \ 4) * (bh + GAP), bw, bh)
        With shp
            .Name = BTN_PREFIX & specs(i)(0)
            .OnAction = specs(i)(0)
            .Placement = xlFreeFloating
            .Fill.ForeColor.RGB = specs(i)(2)
            .Line.Visible = msoFalse
            With .TextFrame2
                .VerticalAnchor = msoAnchorMiddle
                .WordWrap = msoTrue
                .MarginLeft = 2
                .MarginRight = 2
                .MarginTop = 1
                .MarginBottom = 1
                With .TextRange
                    .Text = specs(i)(1)
                    .Font.Size = 9
                    .Font.Bold = msoTrue
                    .Font.Fill.ForeColor.RGB = RGB(255, 255, 255)
                    .ParagraphFormat.Alignment = msoAlignCenter
                End With
            End With
        End With
    Next i
End Sub

Private Sub MigrateHoldFills(ws As Worksheet)
    Dim f As Range, sw As Range, holdColor As Long, r As Long, c As Long, lastR As Long
    Dim rowsFound As Collection, item As Variant

    If cCond = 0 Then Exit Sub
    Set f = ws.Range(ws.Cells(1, 1), ws.Cells(FIRST_DATA_ROW - 1, cLastCol)).Find( _
                What:="HOLD", LookIn:=xlValues, LookAt:=xlPart, MatchCase:=False)
    If f Is Nothing Then Exit Sub
    If f.Column = 1 Then Exit Sub
    Set sw = f.Offset(0, -1).MergeArea.Cells(1, 1)
    If sw.Interior.ColorIndex = xlColorIndexNone Then Exit Sub
    holdColor = sw.Interior.Color

    Set rowsFound = New Collection
    lastR = LastDataRow(ws)
    For r = FIRST_DATA_ROW To lastR
        If Len(Trim$(CellText(ws.Cells(r, cCond).Value))) = 0 And Len(CellText(ws.Cells(r, cPart).Value)) > 0 Then
            For c = 1 To cLastCol
                If ws.Cells(r, c).Interior.ColorIndex <> xlColorIndexNone Then
                    If ws.Cells(r, c).Interior.Color = holdColor Then
                        rowsFound.Add r
                        Exit For
                    End If
                End If
            Next c
        End If
    Next r
    If rowsFound.Count = 0 Then Exit Sub

    If MsgBox(rowsFound.Count & " row(s) are colored with the brown HOLD DO NOT USE legend color." & vbLf & vbLf & _
              "Set their CONDITION to """ & HOLD_TEXT & """ so they're flagged automatically " & _
              "(and PULL warns before using them)?", vbYesNo + vbQuestion, APP_TITLE) = vbNo Then Exit Sub
    For Each item In rowsFound
        ws.Cells(item, cCond).Value = HOLD_TEXT
    Next item
End Sub


