Private Sub DoPull(ws As Worksheet, ByVal r As Long)
    Dim part As String, onHand As Double, qty As Double, newQty As Double, minQ As Double
    Dim note As String, cancelled As Boolean

    part = CellText(ws.Cells(r, cPart).Value)
    onHand = NumVal(ws.Cells(r, cOnHand).Value)
    SelectRow ws, r, cOnHand

    If IsOnHold(ws, r) Then
        If MsgBox("WARNING: " & part & " is marked " & HOLD_TEXT & "." & vbLf & vbLf & "Pull it anyway?", _
                  vbYesNo + vbExclamation + vbDefaultButton2, APP_TITLE) = vbNo Then Exit Sub
    End If
    If onHand <= 0 Then
        MsgBox part & " shows 0 on hand - nothing to pull.", vbExclamation, APP_TITLE
        Exit Sub
    End If

    qty = AskQty(ItemSummary(ws, r) & vbLf & vbLf & "Quantity to PULL?", "Pull / Use Item", 1)
    If qty <= 0 Then Exit Sub
    If qty > onHand Then
        If MsgBox("Only " & onHand & " on hand." & vbLf & "Pull all " & onHand & "?", _
                  vbYesNo + vbQuestion, APP_TITLE) = vbNo Then Exit Sub
        qty = onHand
    End If
    note = AskText("What is it for?  (program, charge #, or a note - optional)", "Pull / Use Item", "", cancelled)

    newQty = onHand - qty
    ws.Cells(r, cOnHand).Value = newQty
    WriteLog "PULL", part, -qty, newQty, note

    If cMin > 0 Then minQ = NumVal(ws.Cells(r, cMin).Value)
    If newQty <= 0 Then
        MsgBox part & " is now OUT OF STOCK.", vbExclamation, APP_TITLE
    ElseIf minQ > 0 And newQty <= minQ Then
        MsgBox part & " is now at/below MIN STOCK  (" & newQty & " on hand, min " & minQ & ").", _
               vbInformation, APP_TITLE
    End If
End Sub

Private Sub DoReceive(ws As Worksheet, ByVal r As Long)
    Dim part As String, onHand As Double, qty As Double, newQty As Double
    Dim onOrd As Double, newOrd As Double, note As String

    part = CellText(ws.Cells(r, cPart).Value)
    onHand = NumVal(ws.Cells(r, cOnHand).Value)
    SelectRow ws, r, cOnHand

    qty = AskQty(ItemSummary(ws, r) & vbLf & vbLf & "Quantity RECEIVED?", "Receive Item", 1)
    If qty <= 0 Then Exit Sub

    newQty = onHand + qty
    ws.Cells(r, cOnHand).Value = newQty

    If cOnOrder > 0 Then
        onOrd = NumVal(ws.Cells(r, cOnOrder).Value)
        If onOrd > 0 Then
            newOrd = onOrd - qty
            If newOrd < 0 Then newOrd = 0
            ws.Cells(r, cOnOrder).Value = newOrd
            note = "On Order " & onOrd & " -> " & newOrd
            If cLastPurch > 0 Then
                StampLastPurchased ws.Cells(r, cLastPurch)
                note = note & "; Last Purchased updated"
            End If
        End If
    End If
    WriteLog "RECEIVE", part, qty, newQty, note
End Sub

Private Sub StampLastPurchased(ByVal c As Range)
    Dim v As Variant, fmt As String
    If c.HasFormula Then Exit Sub
    v = c.Value
    fmt = LCase$(c.NumberFormat)
    If VarType(v) = vbDate Then
        c.Value = Date
    ElseIf IsEmpty(v) And (InStr(fmt, "d") > 0 Or InStr(fmt, "m") > 0) Then
        c.Value = Date
    Else
        c.Value = Year(Date)
    End If
End Sub


