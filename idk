Private Function GetInv() As Worksheet
    Dim ws As Worksheet
    Set ws = SheetByName(SHEET_NAME)
    If ws Is Nothing Then
        MsgBox "Couldn't find a sheet named """ & SHEET_NAME & """." & vbLf & _
               "Rename the inventory tab, or change SHEET_NAME at the top of the module.", _
               vbCritical, APP_TITLE
        Exit Function
    End If
    If Not LoadCols(ws, True) Then Exit Function
    Set GetInv = ws
End Function

Private Function LoadCols(ws As Worksheet, Optional ByVal showMsg As Boolean = False) As Boolean
    Dim c As Long, lastC As Long, h As String, missing As String

    cScan = 0: cPart = 0: cDesc = 0: cShelf = 0: cBin = 0: cOnHand = 0: cMin = 0: cCond = 0
    cOnOrder = 0: cOrderNo = 0: cProgram = 0: cCharge = 0: cLastPurch = 0: cTNum = 0
    cBarPrint = 0: cSku = 0: cMfg = 0: cLastCol = 0

    lastC = ws.Cells(HEADER_ROW, ws.Columns.Count).End(xlToLeft).Column
    c = ws.Cells(HEADER_ROW + 1, ws.Columns.Count).End(xlToLeft).Column
    If c > lastC Then lastC = c
    With ws.Cells(HEADER_ROW, lastC).MergeArea
        If .Column + .Columns.Count - 1 > lastC Then lastC = .Column + .Columns.Count - 1
    End With

    For c = 1 To lastC
        h = HeaderText(ws, c)
        If Len(h) > 0 Then
            Select Case True
                Case h Like "BARCODE SCAN*": If cScan = 0 Then cScan = c
                Case h Like "BARCODE PRINT*": If cBarPrint = 0 Then cBarPrint = c
                Case h Like "PART*": If cPart = 0 Then cPart = c
                Case h Like "DESC*": If cDesc = 0 Then cDesc = c
                Case h Like "SHELF*": If cShelf = 0 Then cShelf = c
                Case h Like "BIN*": If cBin = 0 Then cBin = c
                Case h Like "ON HAND*": If cOnHand = 0 Then cOnHand = c
                Case h Like "MIN*": If cMin = 0 Then cMin = c
                Case h Like "CONDITION*": If cCond = 0 Then cCond = c
                Case h Like "ON ORDER*": If cOnOrder = 0 Then cOnOrder = c
                Case h Like "ORDER*": If cOrderNo = 0 Then cOrderNo = c
                Case h Like "PROGRAM*": If cProgram = 0 Then cProgram = c
                Case h Like "CHARGE*": If cCharge = 0 Then cCharge = c
                Case h Like "LAST PURCH*": If cLastPurch = 0 Then cLastPurch = c
                Case h Like "T NUM*", h Like "T-NUM*": If cTNum = 0 Then cTNum = c
                Case h Like "SKU*": If cSku = 0 Then cSku = c
                Case h Like "MFG*", h Like "MANUFACT*": If cMfg = 0 Then cMfg = c
            End Select
        End If
    Next c
    cLastCol = lastC

    If cPart = 0 Then missing = missing & "PART NUMBER, "
    If cDesc = 0 Then missing = missing & "DESCRIPTION, "
    If cShelf = 0 Then missing = missing & "SHELF, "
    If cOnHand = 0 Then missing = missing & "ON HAND QTY, "
    If Len(missing) > 0 Then
        If showMsg Then
            MsgBox "Couldn't find these column titles in rows " & HEADER_ROW & "-" & (HEADER_ROW + 1) & ":" & _
                   vbLf & "   " & Left$(missing, Len(missing) - 2) & vbLf & vbLf & _
                   "Check HEADER_ROW / FIRST_DATA_ROW at the top of the module.", _
                   vbCritical, APP_TITLE
        End If
        Exit Function
    End If
    LoadCols = True
End Function

Private Function HeaderText(ws As Worksheet, ByVal c As Long) As String
    Dim a As String, b As String, s As String, m As Range
    Set m = ws.Cells(HEADER_ROW, c).MergeArea
    If m.Column = c Then a = CellText(m.Cells(1, 1).Value)
    Set m = ws.Cells(HEADER_ROW + 1, c).MergeArea
    If m.Row = HEADER_ROW + 1 And m.Column = c Then b = CellText(m.Cells(1, 1).Value)
    s = UCase$(a & " " & b)
    s = Replace(s, vbCr, " ")
    s = Replace(s, vbLf, " ")
    s = Replace(s, Chr$(160), " ")
    Do While InStr(s, "  ") > 0
        s = Replace(s, "  ", " ")
    Loop
    HeaderText = Trim$(s)
End Function

Private Function LastDataRow(ws As Worksheet) As Long
    Dim f As Range
    Set f = ws.Columns(cPart).Find(What:="*", LookIn:=xlFormulas, LookAt:=xlPart, _
                                   SearchOrder:=xlByRows, SearchDirection:=xlPrevious)
    If f Is Nothing Then
        LastDataRow = FIRST_DATA_ROW - 1
    ElseIf f.Row < FIRST_DATA_ROW Then
        LastDataRow = FIRST_DATA_ROW - 1
    Else
        LastDataRow = f.Row
    End If
End Function

Private Function FindPartRow(ws As Worksheet, ByVal part As String, ByVal excludeRow As Long) As Long
    Dim k As String, lastR As Long, v As Variant, i As Long
    k = NormKey(part)
    If k = "" Then Exit Function
    lastR = LastDataRow(ws)
    If lastR < FIRST_DATA_ROW Then Exit Function
    v = ColValues(ws, cPart, lastR)
    For i = 1 To UBound(v, 1)
        If (i + FIRST_DATA_ROW - 1) <> excludeRow Then
            If NormKey(v(i, 1)) = k Then
                FindPartRow = i + FIRST_DATA_ROW - 1
                Exit Function
            End If
        End If
    Next i
End Function

Private Function ColValues(ws As Worksheet, ByVal col As Long, ByVal lastR As Long) As Variant
    Dim v As Variant
    If lastR <= FIRST_DATA_ROW Then
        ReDim v(1 To 1, 1 To 1)
        v(1, 1) = ws.Cells(FIRST_DATA_ROW, col).Value
    Else
        v = ws.Range(ws.Cells(FIRST_DATA_ROW, col), ws.Cells(lastR, col)).Value
    End If
    ColValues = v
End Function

Private Function ColValuesOpt(ws As Worksheet, ByVal col As Long, ByVal lastR As Long) As Variant
    If col > 0 Then ColValuesOpt = ColValues(ws, col, lastR) Else ColValuesOpt = Empty
End Function

Private Function ArrVal(v As Variant, ByVal i As Long) As Variant
    If IsArray(v) Then ArrVal = v(i, 1) Else ArrVal = Empty
End Function

Private Function ColRange(ws As Worksheet, ByVal col As Long) As Range
    Set ColRange = ws.Range(ws.Cells(FIRST_DATA_ROW, col), ws.Cells(MAX_ROW, col))
End Function

Private Function ColL(ByVal c As Long) As String
    Dim n As Long, s As String
    n = c
    Do While n > 0
        s = Chr$(65 + ((n - 1) Mod 26)) & s
        n = (n - 1) \ 26
    Loop
    ColL = s
End Function

Private Sub ShowAllRows(ws As Worksheet)
    Dim lastR As Long
    On Error Resume Next
    If ws.FilterMode Then ws.ShowAllData
    On Error GoTo 0
    lastR = LastDataRow(ws)
    If lastR >= FIRST_DATA_ROW Then ws.Rows(FIRST_DATA_ROW & ":" & lastR).Hidden = False
End Sub

Private Sub SelectCell(ws As Worksheet, ByVal c As Range)
    ws.Activate
    c.Select
    EnsureVisible c
    If c.Column = cDesc Then
        gPrevDescAddr = c.Address
        gPrevDescVal = CellText(c.Value)
    End If
End Sub

Private Sub SelectRow(ws As Worksheet, ByVal r As Long, ByVal focusCol As Long)
    ws.Activate
    ws.Range(ws.Cells(r, 1), ws.Cells(r, cLastCol)).Select
    ws.Cells(r, focusCol).Activate
    EnsureVisible ws.Cells(r, focusCol)
End Sub

Private Sub EnsureVisible(ByVal c As Range)
    On Error Resume Next
    If Intersect(ActiveWindow.VisibleRange, c) Is Nothing Then
        ActiveWindow.ScrollRow = MaxL(FIRST_DATA_ROW, c.Row - 8)
        If Intersect(ActiveWindow.VisibleRange, c) Is Nothing Then ActiveWindow.ScrollColumn = MaxL(1, c.Column - 1)
    End If
End Sub

Private Function RowEmptyExcept(ws As Worksheet, ByVal r As Long, ByVal exceptCol As Long) As Boolean
    Dim c As Long, cel As Range
    For c = 1 To cLastCol
        If c <> exceptCol Then
            Set cel = ws.Cells(r, c)
            If Not cel.HasFormula Then
                If Len(CellText(cel.Value)) > 0 Then Exit Function
            End If
        End If
    Next c
    RowEmptyExcept = True
End Function

Private Sub ClearRowConstants(ws As Worksheet, ByVal r As Long)
    Dim c As Long
    For c = 1 To cLastCol
        If Not ws.Cells(r, c).HasFormula Then ws.Cells(r, c).ClearContents
    Next c
End Sub

Private Sub SetIfBlank(ws As Worksheet, ByVal r As Long, ByVal col As Long, ByVal v As Variant)
    If col = 0 Then Exit Sub
    If Len(CellText(ws.Cells(r, col).Value)) = 0 Then ws.Cells(r, col).Value = v
End Sub

Private Function IsOnHold(ws As Worksheet, ByVal r As Long) As Boolean
    If cCond > 0 Then IsOnHold = (InStr(1, UCase$(CellText(ws.Cells(r, cCond).Value)), "HOLD") > 0)
End Function

Private Function IsTextCol(ByVal c As Long) As Boolean
    IsTextCol = (c = cShelf Or c = cBin Or c = cProgram Or c = cCharge Or c = cTNum Or _
                 c = cSku Or c = cMfg Or c = cCond Or c = cScan Or c = cBarPrint)
End Function

Private Function LocText(ws As Worksheet, ByVal r As Long) As String
    Dim s As String, b As String
    s = Trim$(Replace(CellText(ws.Cells(r, cShelf).Value), vbLf, " "))
    If s = "" Then s = "(no shelf)"
    If cBin > 0 Then
        b = Trim$(CellText(ws.Cells(r, cBin).Value))
        If b <> "" Then s = s & ", Bin " & b
    End If
    LocText = s
End Function

Private Function ItemSummary(ws As Worksheet, ByVal r As Long) As String
    Dim s As String, d As String, oo As Double
    s = CellText(ws.Cells(r, cPart).Value)
    d = MainPart(CellText(ws.Cells(r, cDesc).Value))
    If d <> "" Then s = s & "   -   " & d
    s = s & vbLf & "Location: " & LocText(ws, r)
    s = s & vbLf & "On hand: " & NumVal(ws.Cells(r, cOnHand).Value)
    If cOnOrder > 0 Then
        oo = NumVal(ws.Cells(r, cOnOrder).Value)
        If oo > 0 Then s = s & "      On order: " & oo
    End If
    ItemSummary = s
End Function

Private Function AskQty(ByVal prompt As String, ByVal title As String, ByVal defaultQty As Double) As Double
    Dim r As Variant
    Do
        r = Application.InputBox(prompt, title, defaultQty, Type:=1)
        If VarType(r) = vbBoolean Then
            AskQty = -1
            Exit Function
        End If
        If r >= 0 Then
            AskQty = r
            Exit Function
        End If
        MsgBox "Enter a quantity of 0 or more.", vbExclamation, APP_TITLE
    Loop
End Function

Private Function AskText(ByVal prompt As String, ByVal title As String, ByVal def As String, _
                         ByRef cancelled As Boolean) As String
    Dim r As Variant
    r = Application.InputBox(prompt, title, def, Type:=2)
    If VarType(r) = vbBoolean Then
        cancelled = True
        AskText = ""
    Else
        cancelled = False
        AskText = CleanScan(CStr(r))
    End If
End Function

Private Sub WriteLog(ByVal action As String, ByVal part As String, ByVal qtyChange As Variant, _
                     ByVal newQty As Variant, Optional ByVal note As String = "")
    Dim lg As Worksheet, r As Long
    Set lg = GetLogSheet()
    r = lg.Cells(lg.Rows.Count, 1).End(xlUp).Row + 1
    lg.Cells(r, 1).Value = Now
    lg.Cells(r, 2).Value = Environ$("USERNAME")
    lg.Cells(r, 3).Value = action
    lg.Cells(r, 4).NumberFormat = "@"
    lg.Cells(r, 4).Value = part
    lg.Cells(r, 5).Value = qtyChange
    lg.Cells(r, 6).Value = newQty
    lg.Cells(r, 7).Value = note
End Sub

Private Function GetLogSheet() As Worksheet
    Dim lg As Worksheet
    Set lg = SheetByName(LOG_SHEET)
    If lg Is Nothing Then
        Set lg = GetOrCreateSheet(LOG_SHEET)
        lg.Range("A1:G1").Value = Array("DATE / TIME", "USER", "ACTION", "PART NUMBER", "QTY CHANGE", _
                                        "NEW ON HAND", "NOTES")
        With lg.Range("A1:G1")
            .Font.Bold = True
            .Font.Color = RGB(255, 255, 255)
            .Interior.Color = RGB(31, 56, 100)
        End With
        lg.Columns("A").NumberFormat = "mm/dd/yyyy h:mm AM/PM"
        lg.Columns("A").ColumnWidth = 20
        lg.Columns("B").ColumnWidth = 14
        lg.Columns("C").ColumnWidth = 12
        lg.Columns("D").ColumnWidth = 22
        lg.Columns("E:F").ColumnWidth = 13
        lg.Columns("G").ColumnWidth = 80
        lg.Tab.Color = RGB(31, 56, 100)
    End If
    Set GetLogSheet = lg
End Function

Private Function GetOrCreateSheet(ByVal nm As String) As Worksheet
    Dim sh As Worksheet, prev As Object
    Set sh = SheetByName(nm)
    If sh Is Nothing Then
        Set prev = ActiveSheet
        Set sh = ThisWorkbook.Worksheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
        sh.Name = nm
        If Not prev Is Nothing Then prev.Activate
    End If
    Set GetOrCreateSheet = sh
End Function

Private Function SheetByName(ByVal nm As String) As Worksheet
    On Error Resume Next
    Set SheetByName = ThisWorkbook.Worksheets(nm)
End Function

Private Sub RestoreAutoComplete()
    If gACStored Then
        Application.EnableAutoComplete = gAutoCompleteWas
        gACStored = False
    End If
End Sub

Private Function CellText(ByVal v As Variant) As String
    If IsArray(v) Then Exit Function
    If IsError(v) Then Exit Function
    If IsEmpty(v) Or IsNull(v) Then Exit Function
    CellText = CStr(v)
End Function

Private Function NormKey(ByVal v As Variant) As String
    Dim s As String
    s = CellText(v)
    s = Replace(s, vbCr, "")
    s = Replace(s, vbLf, "")
    s = Replace(s, vbTab, "")
    s = Replace(s, Chr$(160), " ")
    NormKey = UCase$(Trim$(s))
End Function

Private Function CleanScan(ByVal s As String) As String
    s = Replace(s, vbCr, "")
    s = Replace(s, vbLf, "")
    s = Replace(s, vbTab, "")
    s = Replace(s, Chr$(160), " ")
    CleanScan = Trim$(s)
End Function

Private Function NumVal(ByVal v As Variant) As Double
    If IsError(v) Then Exit Function
    If IsNumeric(v) Then NumVal = CDbl(v)
End Function

Private Function ToNum(ByVal v As Variant, ByRef ok As Boolean) As Double
    ok = False
    If IsError(v) Or IsEmpty(v) Then Exit Function
    If VarType(v) = vbDate Then
        ToNum = CDbl(v)
        ok = True
    ElseIf IsNumeric(v) Then
        ToNum = CDbl(v)
        ok = True
    End If
End Function

Private Function JoinDistinct(ByVal sa As String, ByVal sb As String) As String
    If InStr(1, " / " & UCase$(sa) & " / ", " / " & UCase$(sb) & " / ", vbBinaryCompare) > 0 Then
        JoinDistinct = sa
    Else
        JoinDistinct = sa & " / " & sb
    End If
End Function

Private Sub AddNote(ByRef notes As String, ByVal txt As String)
    If InStr(1, notes, txt, vbTextCompare) = 0 Then notes = notes & txt & "; "
End Sub

Private Function MaxL(ByVal a As Long, ByVal b As Long) As Long
    If a > b Then MaxL = a Else MaxL = b
End Function

Private Sub ShowErr()
    MsgBox "Inventory tools hit a problem:" & vbLf & vbLf & Err.Description & vbLf & vbLf & _
           "If buttons/dropdowns stop reacting, run Inv_Reset (Alt+F8).", vbExclamation, APP_TITLE
End Sub
