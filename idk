'==============================================================================

Private Sub MergeRowInto(ws As Worksheet, data As Variant, ByVal j As Long, ByVal i As Long, _
                         ByRef conflicts As String)
    Dim c As Long, a As Variant, b As Variant, newV As Variant, changed As Boolean
    Dim rowJ As Long, sa As String, sb As String, okA As Boolean, okB As Boolean
    Dim na As Double, nb As Double

    rowJ = j + FIRST_DATA_ROW - 1
    For c = 1 To cLastCol
        If c <> cPart Then
            a = data(j, c)
            b = data(i, c)
            changed = False
            If Not IsError(a) And Not IsError(b) Then
                sa = Trim$(CellText(a))
                sb = Trim$(CellText(b))
                If sb <> "" Then
                    Select Case c
                        Case cOnHand, cOnOrder
                            If NumVal(b) <> 0 Then
                                newV = NumVal(a) + NumVal(b)
                                changed = True
                            End If
                        Case cMin
                            If NumVal(b) > NumVal(a) Then
                                newV = b
                                changed = True
                            End If
                        Case cLastPurch
                            If sa = "" Then
                                newV = b
                                changed = True
                            Else
                                na = ToNum(a, okA)
                                nb = ToNum(b, okB)
                                If okA And okB Then
                                    If nb > na Then
                                        newV = b
                                        changed = True
                                    End If
                                ElseIf UCase$(sa) <> UCase$(sb) Then
                                    newV = JoinDistinct(sa, sb)
                                    changed = (CStr(newV) <> sa)
                                End If
                            End If
                        Case cDesc
                            If sa = "" Then
                                newV = b
                                changed = True
                            ElseIf UCase$(MainPart(sa)) <> UCase$(MainPart(sb)) Then
                                AddNote conflicts, "description also listed as " & MainPart(sb)
                            End If
                        Case cOrderNo
                            If sb <> "0" Then
                                If sa = "" Or sa = "0" Then
                                    newV = b
                                    changed = True
                                ElseIf UCase$(sa) <> UCase$(sb) Then
                                    newV = JoinDistinct(sa, sb)
                                    changed = (CStr(newV) <> sa)
                                End If
                            End If
                        Case Else
                            If sa = "" Then
                                newV = b
                                changed = True
                            ElseIf UCase$(sa) <> UCase$(sb) Then
                                If IsNumeric(a) And IsNumeric(b) And Not IsTextCol(c) Then
                                    AddNote conflicts, HeaderText(ws, c) & " " & sa & " vs " & sb
                                Else
                                    newV = JoinDistinct(sa, sb)
                                    changed = (CStr(newV) <> sa)
                                    If changed And (c = cShelf Or c = cBin) Then AddNote conflicts, "stored in more than one location"
                                End If
                            End If
                    End Select
                End If
            End If

            If changed Then
                If Not ws.Cells(rowJ, c).HasFormula Then
                    ws.Cells(rowJ, c).Value = newV
                    data(j, c) = newV
                    If c = cDesc Then FormatDescCell ws.Cells(rowJ, c)
                End If
            End If
        End If
    Next c
End Sub

Private Function MakeBackup(ws As Worksheet) As String
    Dim wb As Workbook, bk As Worksheet, nm As String, i As Long
    Set wb = ws.Parent
    Application.DisplayAlerts = False
    ws.Copy After:=wb.Sheets(wb.Sheets.Count)
    Application.DisplayAlerts = True
    Set bk = wb.Sheets(wb.Sheets.Count)

    nm = "Backup " & Format$(Now, "yyyy-mm-dd hhmm")
    i = 1
    Do While Not SheetByName(nm) Is Nothing
        i = i + 1
        nm = "Backup " & Format$(Now, "yyyy-mm-dd hhmm") & " (" & i & ")"
    Loop
    bk.Name = Left$(nm, 31)
    bk.Tab.Color = RGB(128, 128, 128)

    For i = bk.Shapes.Count To 1 Step -1
        If bk.Shapes(i).Name Like BTN_PREFIX & "*" Then bk.Shapes(i).Delete
    Next i
    ws.Activate
    MakeBackup = bk.Name
End Function


