Private Sub WriteDescription(ByVal c As Range, ByVal mainTxt As String, ByVal subTxt As String)
    Dim pre As String
    If Left$(mainTxt, 1) Like "[=+@-]" Then pre = "'"
    If Len(subTxt) > 0 Then
        c.Value = pre & mainTxt & vbLf & subTxt
    Else
        c.Value = pre & mainTxt
    End If
    c.WrapText = True
    FormatDescCell c
    c.EntireRow.AutoFit
    gPrevDescAddr = c.Address
    gPrevDescVal = CellText(c.Value)
End Sub

Private Sub FormatDescCell(ByVal c As Range)
    Dim v As String, p As Long
    If c.HasFormula Then Exit Sub
    v = CellText(c.Value)
    With c.Font
        .Size = MAIN_FONT_SIZE
        .Italic = False
        .ColorIndex = xlColorIndexAutomatic
    End With
    p = InStr(v, vbLf)
    If p > 0 And Len(v) > p Then
        c.WrapText = True
        With c.Characters(p + 1, Len(v) - p).Font
            .Size = SUB_FONT_SIZE
            .Italic = True
            .Color = RGB(89, 89, 89)
        End With
    End If
End Sub

Private Sub RestorePrevDesc(ByVal c As Range)
    If gPrevDescAddr = c.Address And Len(gPrevDescVal) > 0 Then
        c.Value = gPrevDescVal
        FormatDescCell c
    Else
        c.ClearContents
    End If
End Sub

Private Function MainPart(ByVal s As String) As String
    Dim p As Long
    p = InStr(s, vbLf)
    If p > 0 Then MainPart = Left$(s, p - 1) Else MainPart = s
End Function

Private Function SubPart(ByVal s As String) As String
    Dim p As Long
    p = InStr(s, vbLf)
    If p > 0 Then SubPart = Mid$(s, p + 1)
End Function


