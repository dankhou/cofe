Public Sub Inv_OnChange(ByVal Target As Range)
    Dim ws As Worksheet, hit As Range, c As Range
    If gBusy Then Exit Sub
    Set ws = Target.Worksheet
    If ws.Name <> SHEET_NAME Then Exit Sub
    If Target.Row + Target.Rows.Count - 1 < FIRST_DATA_ROW Then Exit Sub
    If Not LoadCols(ws) Then Exit Sub

    gBusy = True
    Application.EnableEvents = False
    On Error GoTo Fail

    If Target.CountLarge = 1 Then
        If Target.Row >= FIRST_DATA_ROW And Target.Row <= MAX_ROW Then
            Select Case Target.Column
                Case cPart
                    OnPartEntered ws, Target
                Case cDesc
                    OnDescEntered ws, Target
                Case cShelf
                    If Len(CellText(Target.Value)) > 0 Then
                        If CellText(Target.Value) <> UCase$(Trim$(CellText(Target.Value))) Then
                            Target.Value = UCase$(Trim$(CellText(Target.Value)))
                        End If
                        If Target.Row = gPendingRow Then
                            If cBin > 0 Then
                                Application.StatusBar = "ADD ITEM: type the BIN number and press Enter."
                                SelectCell ws, ws.Cells(Target.Row, cBin)
                            Else
                                FinishPending ws, Target.Row
                            End If
                        End If
                    End If
                Case cBin
                    If Target.Row = gPendingRow And Len(CellText(Target.Value)) > 0 Then FinishPending ws, Target.Row
            End Select
        End If
    Else
        Set hit = Intersect(Target, ws.Range(ws.Cells(FIRST_DATA_ROW, cDesc), ws.Cells(MAX_ROW, cDesc)))
        If Not hit Is Nothing Then
            If hit.CountLarge <= 2000 Then
                For Each c In hit.Cells
                    FormatDescCell c
                Next c
            End If
        End If
    End If
Done:
    Application.EnableEvents = True
    gBusy = False
    Exit Sub
Fail:
    ShowErr
    Resume Done
End Sub

Public Sub Inv_OnSelect(ByVal Target As Range)
    If gBusy Then Exit Sub
    If Target.Worksheet.Name <> SHEET_NAME Then Exit Sub
    If Target.CountLarge <> 1 Then Exit Sub
    If cDesc = 0 Then
        If Not LoadCols(Target.Worksheet) Then Exit Sub
    End If
    If Target.Column = cDesc Then
        gPrevDescAddr = Target.Address
        gPrevDescVal = CellText(Target.Value)
    End If
End Sub

Public Sub Inv_OnDoubleClick(ByVal Target As Range, ByRef Cancel As Boolean)
    Dim v As String, subTxt As String, cancelled As Boolean
    If Target.Worksheet.Name <> SHEET_NAME Then Exit Sub
    If Target.CountLarge <> 1 Or Target.Row < FIRST_DATA_ROW Then Exit Sub
    If Not LoadCols(Target.Worksheet) Then Exit Sub
    If Target.Column <> cDesc Then Exit Sub
    v = CellText(Target.Value)
    If Trim$(v) = "" Then Exit Sub

    Cancel = True
    subTxt = AskText("SUB-DESCRIPTION for " & MainPart(v) & ":" & vbLf & vbLf & _
                     "(Clear the box and click OK to remove it.)", "Edit Sub Description", SubPart(v), cancelled)
    If cancelled Then Exit Sub

    On Error GoTo Fail
    gBusy = True
    Application.EnableEvents = False
    WriteDescription Target, MainPart(v), subTxt
Done:
    Application.EnableEvents = True
    gBusy = False
    Exit Sub
Fail:
    ShowErr
    Resume Done
End Sub


'==============================================================================
'                               ADD ITEM FLOW
'==============================================================================

Private Sub StartNewItem(ws As Worksheet)
    Dim r As Long
    gPendingRow = 0
    ShowAllRows ws
    r = LastDataRow(ws) + 1
    If r > MAX_ROW Then
        MsgBox "The list has reached row " & MAX_ROW & "." & vbLf & _
               "Increase MAX_ROW at the top of the module and run Inv_Setup again.", _
               vbExclamation, APP_TITLE
        Exit Sub
    End If

    PrepareNewRow ws, r
    gPendingRow = r

    ' Excel AutoComplete can "finish" a scanned part # into a longer existing one - turn it off while scanning
    If Not gACStored Then
        gAutoCompleteWas = Application.EnableAutoComplete
        gACStored = True
    End If
    Application.EnableAutoComplete = False

    ws.Activate
    ws.Cells(r, cPart).Select
    EnsureVisible ws.Cells(r, cPart)
    Application.StatusBar = "ADD ITEM: scan (or type) the PART NUMBER into row " & r & " and press Enter."
End Sub

Private Sub OnPartEntered(ws As Worksheet, ByVal c As Range)
    Dim part As String, r As Long, exRow As Long, isNew As Boolean
    Dim qty As Double, newQty As Double

    RestoreAutoComplete
    r = c.Row
    part = CleanScan(CellText(c.Value))
    If part = "" Then Exit Sub
    If CellText(c.Value) <> part Then c.Value = part

    isNew = (r = gPendingRow) Or RowEmptyExcept(ws, r, cPart)
    exRow = FindPartRow(ws, part, r)

    If exRow > 0 Then
        If isNew Then
            qty = AskQty("Part " & part & " is ALREADY in the inventory:" & vbLf & vbLf & _
                         "   Row " & exRow & "   |   " & LocText(ws, exRow) & "   |   On hand: " & _
                         NumVal(ws.Cells(exRow, cOnHand).Value) & vbLf & vbLf & _
                         "Quantity to ADD to that entry?  (Cancel = add nothing)", "Duplicate Part - Combine", 1)
            ClearRowConstants ws, r
            gPendingRow = 0
            Application.StatusBar = False
            If qty > 0 Then
                newQty = NumVal(ws.Cells(exRow, cOnHand).Value) + qty
                ws.Cells(exRow, cOnHand).Value = newQty
                WriteLog "ADD QTY", part, qty, newQty, "Scanned as a new item - combined into existing row " & exRow
            End If
            SelectRow ws, exRow, cOnHand
            If qty > 0 Then
                MsgBox "Combined: " & part & " now has " & newQty & " on hand (row " & exRow & ").", _
                       vbInformation, APP_TITLE
            End If
        Else
            MsgBox "Heads up: " & part & " is also listed in row " & exRow & "." & vbLf & _
                   "Use MERGE DUPES to combine them.", vbExclamation, APP_TITLE
        End If
        Exit Sub
    End If

    If isNew Then
        qty = AskQty("NEW part:  " & part & vbLf & vbLf & "Quantity on hand?", "Add Item", 1)
        If qty < 0 Then
            ClearRowConstants ws, r
            gPendingRow = 0
            Application.StatusBar = False
            ws.Cells(r, cPart).Select
            Exit Sub
        End If
        ws.Cells(r, cOnHand).Value = qty
        SetIfBlank ws, r, cMin, 0
        SetIfBlank ws, r, cOnOrder, 0
        SetIfBlank ws, r, cOrderNo, 0
        WriteLog "ADD NEW", part, qty, qty, "Row " & r
        gPendingRow = r
        Application.StatusBar = "ADD ITEM: pick a DESCRIPTION from the dropdown (Alt + Down Arrow opens it)."
        SelectCell ws, ws.Cells(r, cDesc)
    End If
End Sub

Private Sub OnDescEntered(ws As Worksheet, ByVal c As Range)
    Dim v As String, mainTxt As String, subTxt As String, oldSub As String
    Dim custom As String, cancelled As Boolean

    v = CellText(c.Value)
    If Trim$(v) = "" Then
        FormatDescCell c
        Exit Sub
    End If

    If InStr(v, vbLf) > 0 Then
        FormatDescCell c
        GoTo Advance
    End If

    mainTxt = UCase$(Trim$(v))
    If mainTxt = CUSTOM_ITEM Then
        custom = UCase$(AskText("Type the DESCRIPTION for this part:", "Custom Description", "", cancelled))
        If cancelled Or custom = "" Then
            RestorePrevDesc c
            Exit Sub
        End If
        mainTxt = custom
        If MsgBox("Add """ & mainTxt & """ to the Description dropdown for next time?", _
                  vbYesNo + vbQuestion, APP_TITLE) = vbYes Then AddToList 1, mainTxt
    End If

    If gPrevDescAddr = c.Address Then oldSub = SubPart(gPrevDescVal)
    subTxt = AskText("SUB-DESCRIPTION for " & mainTxt & "  (optional - leave blank to skip)" & vbLf & vbLf & _
                     "Example:  22 " & ChrW(181) & "F, 100 V, " & ChrW(177) & "20%, PC Pin, 2000 hours @ 85" & _
                     ChrW(176) & "C, Polar", "Sub Description", oldSub, cancelled)
    If cancelled Then subTxt = oldSub
    WriteDescription c, mainTxt, subTxt

Advance:
    If c.Row = gPendingRow Then
        Application.StatusBar = "ADD ITEM: pick a SHELF location from the dropdown."
        SelectCell ws, ws.Cells(c.Row, cShelf)
    End If
End Sub

Private Sub FinishPending(ws As Worksheet, ByVal r As Long)
    gPendingRow = 0
    Application.StatusBar = False
    ws.Rows(r).AutoFit
    If MsgBox("Added:  " & CellText(ws.Cells(r, cPart).Value) & "   (" & LocText(ws, r) & ")" & vbLf & vbLf & _
              "Scan another NEW item?", vbYesNo + vbQuestion, APP_TITLE) = vbYes Then
        StartNewItem ws
    End If
End Sub

Private Sub PrepareNewRow(ws As Worksheet, ByVal r As Long)
    Dim c As Long, src As Range, dst As Range, b As Variant
    If r > FIRST_DATA_ROW Then
        For c = 1 To cLastCol
            Set src = ws.Cells(r - 1, c)
            Set dst = ws.Cells(r, c)
            dst.NumberFormat = src.NumberFormat
            dst.HorizontalAlignment = src.HorizontalAlignment
            dst.VerticalAlignment = src.VerticalAlignment
            If Not IsNull(src.WrapText) Then dst.WrapText = src.WrapText
            If Not IsNull(src.Font.Name) Then dst.Font.Name = src.Font.Name
        Next c
    End If
    With ws.Range(ws.Cells(r, 1), ws.Cells(r, cLastCol))
        .Interior.Pattern = xlNone
        .Font.ColorIndex = xlColorIndexAutomatic
        .Font.Bold = False
        .Font.Italic = False
        .Font.Size = MAIN_FONT_SIZE
        For Each b In Array(xlEdgeLeft, xlEdgeTop, xlEdgeBottom, xlEdgeRight, xlInsideVertical)
            With .Borders(b)
                .LineStyle = xlContinuous
                .Weight = xlThin
            End With
        Next b
    End With
    ws.Cells(r, cPart).NumberFormat = "@"
End Sub


